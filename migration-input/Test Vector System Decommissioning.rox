        <Translation TypeCode="Object" CLR_Type="DataLayer.Translation">
         <Culture>de</Culture>
         <Value>Wann benötigen Sie Zugriff (Benachrichtigung mindestens drei Tage im Voraus)</Value>
        </Translation>
        <Translation TypeCode="Object" CLR_Type="DataLayer.Translation">
         <Culture>en-GB</Culture>
         <Value>When do you need access (minimum 2 day notice)</Value>
        </Translation>
        <Translation TypeCode="Object" CLR_Type="DataLayer.Translation">
         <Culture>es</Culture>
         <Value>¿Cuándo necesita acceso (antelación mínima de 2 días)?</Value>
        </Translation>
        <Translation TypeCode="Object" CLR_Type="DataLayer.Translation">
         <Culture>fr</Culture>
         <Value>Date à laquelle l'accès doit vous être accordé (notification 2 jours à l'avance au minimum)</Value>
