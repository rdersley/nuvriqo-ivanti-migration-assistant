   <FieldTranslations TypeCode="Object" IsList="True" ElementType="DataLayer.FieldTranslation">
    <FieldTranslation TypeCode="Object" CLR_Type="DataLayer.FieldTranslation">
     <FieldName>Description</FieldName>
     <Translations TypeCode="Object" IsList="True" ElementType="DataLayer.Translation">
      <Translation TypeCode="Object" CLR_Type="DataLayer.Translation">
       <Culture>de</Culture>
       <Value>Jedes Ausscheiden von Mitarbeitern aufzeichnen, einschließlich Vollzeit-, Teilzeit- und vertraglich befristeten Mitarbeitern</Value>
      </Translation>
      <Translation TypeCode="Object" CLR_Type="DataLayer.Translation">
       <Culture>en-GB</Culture>
       <Value>Log any type of Employee Departure for all employees including Full Time, Part Time, and Contractors</Value>
      </Translation>
      <Translation TypeCode="Object" CLR_Type="DataLayer.Translation">
       <Culture>es</Culture>
       <Value>Registrar cualquier tipo de salida de empleados para todos los empleados, incluidos contratistas, así como personal a tiempo completo y parcial</Value>
      </Translation>
      <Translation TypeCode="Object" CLR_Type="DataLayer.Translation">
       <Culture>fr</Culture>
       <Value>Consigner tout type de départ de collaborateur pour tous les collaborateurs, qu'ils soient à plein temps, à temps partiel ou sous-traitants</Value>
      </Translation>
      <Translation TypeCode="Object" CLR_Type="DataLayer.Translation">
       <Culture>it</Culture>
       <Value>Registrare qualsiasi tipo di partenza dipendente per tutti i dipendenti, inclusi i dipendenti a tempo pieno, part-time e i collaboratori esterni</Value>
      </Translation>
      <Translation TypeCode="Object" CLR_Type="DataLayer.Translation">
       <Culture>ja</Culture>
       <Value>フルタイム、パートタイム、契約社員など含む、すべての従業員の離職ログ</Value>
      </Translation>
      <Translation TypeCode="Object" CLR_Type="DataLayer.Translation">
       <Culture>nl</Culture>
       <Value>Registreer elk type vertrek van werknemers voor alle werknemers, met inbegrip van voltijds, deeltijds en contractant</Value>
      </Translation>
      <Translation TypeCode="Object" CLR_Type="DataLayer.Translation">
       <Culture>pl</Culture>
       <Value>Rejestruj dowolny typ wyjazdu pracownika dla wszystkich pracowników w tym pełnoetatowych, pracujących na niepełny etat i zleceniobiorców</Value>
      </Translation>
      <Translation TypeCode="Object" CLR_Type="DataLayer.Translation">
       <Culture>pt-BR</Culture>
       <Value>Registrar qualquer tipo de Partida de Funcionário para todos os funcionários, incluindo Tempo Integral, Tempo Parcial e Contratantes</Value>
      </Translation>
      <Translation TypeCode="Object" CLR_Type="DataLayer.Translation">
       <Culture>ru</Culture>
       <Value>Заносить в журнал любую информацию об увольнении сотрудника для всех сотрудников, включая работающих полный день, неполный день и по контракту</Value>
      </Translation>
      <Translation TypeCode="Object" CLR_Type="DataLayer.Translation">
       <Culture>zh-CN</Culture>
       <Value>记录所有员工的任何员工离职类型，包括全职、兼职和承包商</Value>
      </Translation>
      <Translation TypeCode="Object" CLR_Type="DataLayer.Translation">
       <Culture>zh-TW</Culture>
       <Value>針對所有員工 (包含全職、兼職，承包商) 任何類型的員工離職進行記錄</Value>
      </Translation>
      <Translation TypeCode="Object" CLR_Type="DataLayer.Translation">
       <Culture></Culture>
       <Value>Log any type of Employee Suspend Access for all employees including Full Time, Part Time, and Contractors</Value>
      </Translation>
     </Translations>
    </FieldTranslation>
