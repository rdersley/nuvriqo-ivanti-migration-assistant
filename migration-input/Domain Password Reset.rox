   <FieldTranslations TypeCode="Object" IsList="True" ElementType="DataLayer.FieldTranslation">
    <FieldTranslation TypeCode="Object" CLR_Type="DataLayer.FieldTranslation">
     <FieldName>Description</FieldName>
     <Translations TypeCode="Object" IsList="True" ElementType="DataLayer.Translation">
      <Translation TypeCode="Object" CLR_Type="DataLayer.Translation">
       <Culture>de</Culture>
       <Value>Rücksetzung Ihres Domänenkennworts beantragen, falls Sie es vergessen haben</Value>
      </Translation>
      <Translation TypeCode="Object" CLR_Type="DataLayer.Translation">
       <Culture>en-GB</Culture>
       <Value>Request to have your domain password reset if you have forgotten it</Value>
      </Translation>
      <Translation TypeCode="Object" CLR_Type="DataLayer.Translation">
       <Culture>es</Culture>
       <Value>Solicitar que le restablezcan su contraseña de dominio, en caso de haberla olvidado</Value>
      </Translation>
      <Translation TypeCode="Object" CLR_Type="DataLayer.Translation">
       <Culture>fr</Culture>
       <Value>Demander la réinitialisation de votre mot de passe de domaine si vous l'avez oublié</Value>
      </Translation>
      <Translation TypeCode="Object" CLR_Type="DataLayer.Translation">
       <Culture>it</Culture>
       <Value>Richiedere la reimpostazione della password di dominio qualora non la si ricordi più</Value>
      </Translation>
      <Translation TypeCode="Object" CLR_Type="DataLayer.Translation">
       <Culture>ja</Culture>
       <Value>ドメイン パスワードを忘れた場合のリセット申請</Value>
      </Translation>
      <Translation TypeCode="Object" CLR_Type="DataLayer.Translation">
       <Culture>nl</Culture>
       <Value>Aanvraag om uw domein wachtwoord opnieuw in te stellen als je het vergeten bent</Value>
      </Translation>
      <Translation TypeCode="Object" CLR_Type="DataLayer.Translation">
       <Culture>pl</Culture>
       <Value>Wniosek o zresetowanie hasła domeny, jeśli zostało zapomniane</Value>
      </Translation>
      <Translation TypeCode="Object" CLR_Type="DataLayer.Translation">
       <Culture>pt-BR</Culture>
       <Value>Solicitação para redefinir sua senha de domínio caso a tenha esquecido</Value>
      </Translation>
      <Translation TypeCode="Object" CLR_Type="DataLayer.Translation">
       <Culture>ru</Culture>
       <Value>Запросить сброс забытого пароля в домене</Value>
      </Translation>
      <Translation TypeCode="Object" CLR_Type="DataLayer.Translation">
       <Culture>zh-CN</Culture>
       <Value>如果您忘记了域密码，请求将其重置</Value>
      </Translation>
      <Translation TypeCode="Object" CLR_Type="DataLayer.Translation">
       <Culture>zh-TW</Culture>
       <Value>若您忘記了網域密碼，請要求將其重設</Value>
      </Translation>
      <Translation TypeCode="Object" CLR_Type="DataLayer.Translation">
       <Culture></Culture>
       <Value>Request to have your domain password reset if you have forgotten it</Value>
      </Translation>
     </Translations>
    </FieldTranslation>
